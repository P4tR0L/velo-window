---
import Layout from "@/layouts/Layout.astro";
import Topbar from "@/components/Topbar.astro";
import RideSearch from "@/components/ride-search/RideSearch";
---

<Layout title="Ride planner">
  <div class="bg-cosmic min-h-screen p-4">
    <div class="mx-auto w-full max-w-2xl">
      <Topbar />
      <div class="rounded-2xl border border-white/10 bg-white/10 p-4 text-white backdrop-blur-xl sm:p-6">
        <h1 class="mb-1 bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-2xl font-bold text-transparent">
          Ride planner
        </h1>
        <p class="mb-5 text-sm text-blue-100/70">Find the hours on your chosen day when the weather fits your ride.</p>
        <RideSearch client:load />
      </div>
    </div>
  </div>
</Layout>
